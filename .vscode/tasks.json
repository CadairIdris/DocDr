{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "dotnet build DocDr.slnx (Debug)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DocDr.slnx",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      "label": "rebuild",
      "detail": "Clean then build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DocDr.slnx",
        "-c",
        "Debug",
        "--no-incremental",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      "label": "test",
      "detail": "dotnet test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/DocDr.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "publish (self-contained)",
      "detail": "publish.ps1 -Mode self-contained  (bundles the .NET runtime)",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/publish.ps1",
        "-Mode",
        "self-contained"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "publish (self-contained, single file)",
      "detail": "publish.ps1 -SingleFile  (one .exe, runtime bundled)",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/publish.ps1",
        "-SingleFile"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "publish (framework-dependent)",
      "detail": "publish.ps1 -Mode framework-dependent  (needs .NET 9 Desktop Runtime)",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/publish.ps1",
        "-Mode",
        "framework-dependent"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
