<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Keys match Palette.Light.xaml exactly. -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#252526" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#2B2B2E" />
    <SolidColorBrush x:Key="OverlayCardBrush" Color="#F52A2A2E" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="HintTextBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TabItemBrush" Color="#333337" />
    <SolidColorBrush x:Key="TabItemActiveBrush" Color="#3F3F46" />
</ResourceDictionary>
