<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys match Palette.Dark.xaml exactly. -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="OverlayCardBrush" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202020" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="HintTextBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="TabItemBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="TabItemActiveBrush" Color="#FCFCFC" />
    <!-- Matches the Fluent light-theme accent (checked RadioButton fill). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5F5099" />
</ResourceDictionary>
