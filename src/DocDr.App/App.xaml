<Application x:Class="DocDr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DocDr.App"
             xmlns:conv="clr-namespace:DocDr.App.Converters"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocDr.App;component/Themes/Palette.Shared.xaml" />
                <!-- Runtime palette (Light / Dark) — swapped by ThemeService; Light is the design-time default. -->
                <ResourceDictionary Source="/DocDr.App;component/Themes/Palette.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:HighlightFillConverter x:Key="HighlightFill" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <conv:SplitViewWidthConverter x:Key="SplitViewWidth" />
            <conv:HighlightSwatchConverter x:Key="HighlightSwatch" />
            <conv:ThumbnailBoxHeightConverter x:Key="ThumbnailBoxHeight" />
            <conv:EqualityConverter x:Key="Equality" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
