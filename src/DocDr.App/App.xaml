<Application x:Class="DocDr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DocDr.App"
             xmlns:conv="clr-namespace:DocDr.App.Converters"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocDr.App;component/Themes/Palette.Shared.xaml" />
                <!-- Runtime palette (Light / Dark) — swapped by ThemeService; Light is the design-time default. -->
                <ResourceDictionary Source="/DocDr.App;component/Themes/Palette.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:HighlightFillConverter x:Key="HighlightFill" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumEqualsOrDefaultConverter x:Key="EnumEqualsOrDefault" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <conv:SplitViewWidthConverter x:Key="SplitViewWidth" />
            <conv:HighlightSwatchConverter x:Key="HighlightSwatch" />
            <conv:ThumbnailBoxHeightConverter x:Key="ThumbnailBoxHeight" />
            <conv:EqualityConverter x:Key="Equality" />
            <conv:NavRailActiveConverter x:Key="NavRailActive" />
            <conv:SnapKindLabelConverter x:Key="SnapKindLabel" />

            <!-- Navigation-section icons, shared by the left rail and (design-time) the panel. -->
            <Geometry x:Key="IconPages">M4,2 H12 V14 H4 Z M6,5.5 H10 M6,8 H10 M6,10.5 H10</Geometry>
            <Geometry x:Key="IconBookmarks">M5,2.5 H11 V13.5 L8,10.8 L5,13.5 Z</Geometry>
            <Geometry x:Key="IconClauses">M4,3 H13 M4,3 V11 M4,7 H9 M4,11 H9 M11,7 H13 M11,11 H13</Geometry>
            <Geometry x:Key="IconAnnotations">M3,3.5 H13 V10.5 H7.5 L4.5,13 V10.5 H3 Z</Geometry>
            <Geometry x:Key="IconMarkup">M10.5,2.5 L13.5,5.5 L6,13 H3 V10 Z M9,4 L12,7</Geometry>

            <!-- Sticky-note icon (24×24): a filled speech bubble with three text lines. Used for the
                 note pin on the page and on Comments panel cards. Fill = the note's colour. -->
            <Geometry x:Key="NoteIconBody">M5,2.5 H19 A3,3 0 0 1 22,5.5 V14 A3,3 0 0 1 19,17 H11 L5.5,21.5 V17 H5 A3,3 0 0 1 2,14 V5.5 A3,3 0 0 1 5,2.5 Z</Geometry>
            <Geometry x:Key="NoteIconLines">M6.5,7 H17.5 M6.5,10 H17.5 M6.5,13 H13.5</Geometry>

            <Style x:Key="NavTabIcon" TargetType="Path">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="StrokeThickness" Value="1.3" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <!-- Own inherited TextElement.Foreground, not a FindAncestor ButtonBase lookup: a
                     button in a collapsed ToolBar overflow (or an unopened menu) isn't in a visual
                     tree yet, and the ancestor binding then logs "Cannot find source" (error 4). -->
                <Setter Property="Stroke"
                        Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
