<Window x:Class="DocDr.App.Views.TableExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:TableExtractViewModel}"
        Title="Extracted table" Width="720" Height="460"
        Icon="/DocDr.App;component/Assets/DocDr.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="0,0,0,8"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource HintTextBrush}"
                           Text="Nested headers may need tidying; the data rows are usually clean." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy (TSV)" MinWidth="90" Padding="8,4"
                            Command="{Binding CopyTsvCommand}" />
                    <Button Content="Save CSV…" MinWidth="90" Padding="8,4" Margin="8,0,0,0"
                            Command="{Binding SaveCsvCommand}" />
                    <Button Content="Close" IsCancel="True" MinWidth="80" Padding="8,4" Margin="8,0,0,0"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True"
                  IsReadOnly="True" HeadersVisibility="None"
                  GridLinesVisibility="All" CanUserResizeRows="False"
                  ColumnWidth="SizeToCells" MaxColumnWidth="320"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="ExcludeHeader" FontSize="12" />
    </DockPanel>
</Window>
