<Window x:Class="DocDr.App.Views.MeasureScaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MeasureScaleViewModel}"
        Title="{Binding Title}" SizeToContent="Height" Width="380"
        Icon="/DocDr.App;component/Assets/DocDr.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <!-- Ratio form -->
        <StackPanel Visibility="{Binding IsRatio, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Drawing scale" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="1 :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14" />
                <TextBox x:Name="RatioBox" Width="90" Text="{Binding RatioText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Scale ratio" />
                <TextBlock Text="measured in" VerticalAlignment="Center" Margin="12,0,6,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="70"
                          AutomationProperties.Name="Unit" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintTextBrush}"
                       Text="As printed on the drawing — e.g. 1:50. For a drawing without a reliable scale, calibrate against a known dimension instead." />
            <Button Content="Calibrate from a known length on the page…" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Padding="10,4" Command="{Binding CalibrateCommand}" />
        </StackPanel>

        <!-- Calibration form (after drawing a line) -->
        <StackPanel Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="How long is the line you drew?" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="KnownBox" Width="110" Text="{Binding KnownLengthText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Known length" />
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="70" Margin="8,0,0,0"
                          AutomationProperties.Name="Unit" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintTextBrush}"
                       Text="Use the longest dimension you can find — a longer line gives a more accurate scale." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Decimal places" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <ComboBox ItemsSource="{Binding DecimalChoices}" SelectedItem="{Binding Decimals}" MinWidth="60"
                      AutomationProperties.Name="Decimal places" />
        </StackPanel>

        <TextBlock Text="Apply to" Margin="0,14,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
        <RadioButton Content="All pages" IsChecked="{Binding ApplyToAllPages}" />
        <RadioButton Content="{Binding ThisPageText}" Margin="0,4,0,0"
                     IsChecked="{Binding ApplyToThisPage}" />
        <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintTextBrush}"
                   Text="Existing measurements keep the scale they were taken at." />

        <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="80" Padding="10,4" Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Content="Apply" MinWidth="80" Padding="10,4" IsDefault="True"
                    Command="{Binding ApplyCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
