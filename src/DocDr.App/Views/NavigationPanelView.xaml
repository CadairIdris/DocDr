<UserControl x:Class="DocDr.App.Views.NavigationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DocDr.App.Views"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentTabViewModel}"
             d:DesignHeight="600" d:DesignWidth="200">
    <!-- Section is chosen from the left icon rail (NavigationRailView); this view is just the
         content for the current NavigationTab. -->
    <Grid Background="{DynamicResource ChromeBrush}">
        <ContentControl Content="{Binding Thumbnails}"
                        Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Pages}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:ThumbnailStripView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Bookmarks}"
                        Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Bookmarks}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:BookmarksPanelView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Clauses}"
                        Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Clauses}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:ClausesPanelView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <ContentControl Content="{Binding Annotations}"
                        Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Annotations}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:AnnotationListView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
