<UserControl x:Class="DocDr.App.Views.NavigationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DocDr.App.Views"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentTabViewModel}"
             d:DesignHeight="600" d:DesignWidth="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="1" Background="{DynamicResource ChromeBrush}">
            <RadioButton GroupName="NavSection" Content="Pages" Padding="4,4"
                         HorizontalContentAlignment="Center"
                         IsChecked="{Binding NavigationTab, Converter={StaticResource EnumEquals}, ConverterParameter=Pages}" />
            <RadioButton GroupName="NavSection" Content="Bookmarks" Padding="4,4"
                         HorizontalContentAlignment="Center"
                         IsChecked="{Binding NavigationTab, Converter={StaticResource EnumEquals}, ConverterParameter=Bookmarks}" />
        </UniformGrid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <ContentControl Content="{Binding Thumbnails}"
                                Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Pages}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:ThumbnailStripView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding Bookmarks}"
                                Visibility="{Binding NavigationTab, Converter={StaticResource EnumToVisibility}, ConverterParameter=Bookmarks}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:BookmarksPanelView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
