<UserControl x:Class="DocDr.App.Views.CommentsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             xmlns:views="clr-namespace:DocDr.App.Views"
             xmlns:pdf="clr-namespace:DocDr.Pdf;assembly=DocDr.Pdf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CommentsViewModel}"
             d:DesignHeight="600" d:DesignWidth="280">
    <UserControl.Resources>
        <!-- Small borderless icon button for the card's ✓ and … -->
        <Style x:Key="CardIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <!-- Review-status pill. Fixed colours read in both themes (white on a saturated fill). -->
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#6B7280" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Accepted">
                    <Setter Property="Background" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Background" Value="#C62828" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#6B7280" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CommentCardTemplate" DataType="{x:Type vm:CommentCardViewModel}">
            <Border x:Name="Card" Margin="6,3,6,3" Padding="10,8,8,8" CornerRadius="6"
                    BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    views:BringIntoViewWhen.Value="{Binding IsSelected}">
                <StackPanel>
                    <!-- Header: icon · author · date · status · ✓ · … -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Viewbox Visibility="{Binding IsNote, Converter={StaticResource BoolToVisibility}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource NoteIconBody}" Fill="{Binding Swatch}"
                                          Stroke="#59000000" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                    <Path Data="{StaticResource NoteIconLines}" Stroke="#A6000000" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Width="18" Height="12" CornerRadius="2" Background="{Binding Swatch}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding IsHighlight, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding When, Mode=OneWay}" FontSize="11"
                                 Foreground="{DynamicResource HintTextBrush}" />
                        </TextBlock>

                        <Border Grid.Column="2" Style="{StaticResource StatusChip}"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="White" />
                        </Border>

                        <Button Grid.Column="3" Command="{Binding ToggleMarkCommand}"
                                AutomationProperties.Name="Mark with checkmark">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardIconButton}">
                                    <Setter Property="ToolTip" Value="Mark with checkmark" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="ToolTip" Value="Checked — click to clear" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="16" Height="16">
                                <Ellipse x:Name="MarkRing" Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                         StrokeThickness="1.3" Margin="1" />
                                <Path Data="M5,8.3 L7.2,10.5 L11.2,5.8" StrokeThickness="1.5"
                                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource CardIconButton}" Click="CardMenu_Click"
                                AutomationProperties.Name="More actions" ToolTip="More actions">
                            <TextBlock Text="⋯" FontSize="14" Margin="0,-3,0,0" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="_Edit…" Command="{Binding EditCommand}" />
                                    <MenuItem Header="Set _status">
                                        <MenuItem Header="None" Command="{Binding SetStatusCommand}"
                                                  CommandParameter="{x:Static pdf:PdfReviewStatus.None}"
                                                  IsChecked="{Binding Status, Mode=OneWay, Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=None}" />
                                        <MenuItem Header="Accepted" Command="{Binding SetStatusCommand}"
                                                  CommandParameter="{x:Static pdf:PdfReviewStatus.Accepted}"
                                                  IsChecked="{Binding Status, Mode=OneWay, Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Accepted}" />
                                        <MenuItem Header="Cancelled" Command="{Binding SetStatusCommand}"
                                                  CommandParameter="{x:Static pdf:PdfReviewStatus.Cancelled}"
                                                  IsChecked="{Binding Status, Mode=OneWay, Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Cancelled}" />
                                        <MenuItem Header="Completed" Command="{Binding SetStatusCommand}"
                                                  CommandParameter="{x:Static pdf:PdfReviewStatus.Completed}"
                                                  IsChecked="{Binding Status, Mode=OneWay, Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Completed}" />
                                        <MenuItem Header="Rejected" Command="{Binding SetStatusCommand}"
                                                  CommandParameter="{x:Static pdf:PdfReviewStatus.Rejected}"
                                                  IsChecked="{Binding Status, Mode=OneWay, Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Rejected}" />
                                    </MenuItem>
                                    <MenuItem Header="_Mark with checkmark" Command="{Binding ToggleMarkCommand}"
                                              IsChecked="{Binding IsMarked, Mode=OneWay}" />
                                    <MenuItem Header="_Copy text" Command="{Binding CopyTextCommand}" />
                                    <Separator />
                                    <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- The note itself -->
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="30,6,0,0"
                               Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Placeholder}" FontStyle="Italic" Margin="30,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding HasText, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- Reply thread -->
                    <ItemsControl ItemsSource="{Binding Replies}" Margin="30,8,0,0"
                                  Visibility="{Binding HasReplies, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CommentReplyViewModel}">
                                <Border BorderThickness="2,0,0,0" BorderBrush="{DynamicResource BorderBrush}"
                                        Padding="8,2,0,2" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                            <Run Text="  " />
                                            <Run Text="{Binding When, Mode=OneWay}" FontSize="11"
                                                 Foreground="{DynamicResource HintTextBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Reply box (selected card only) -->
                    <StackPanel Margin="30,8,0,0"
                                Visibility="{Binding ShowReplyBox, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBox x:Name="ReplyBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="32" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ReplyDraft, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ReplyBox_PreviewKeyDown"
                                     AutomationProperties.Name="Add a reply" />
                            <TextBlock Text="Add a reply" Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource HintTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReplyDraft}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Content="Post" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="12,3"
                                Command="{Binding PostReplyCommand}" ToolTip="Post reply (Ctrl+Enter)" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource TabItemBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource OverlayCardBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Card" Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource ChromeBrush}">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,6">
            <TextBlock Text="Comments" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Count}" FontSize="13" Margin="8,2,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CommentPageGroupViewModel}">
                            <StackPanel Margin="0,2,0,4">
                                <ToggleButton IsChecked="{Binding IsExpanded}" HorizontalContentAlignment="Stretch"
                                              Background="Transparent" BorderThickness="0" Padding="12,5" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Chevron" Text="▾" Width="14"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Header}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding Cards}"
                                              ItemTemplate="{StaticResource CommentCardTemplate}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter TargetName="Chevron" Property="Text" Value="▸" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No comments yet. Use the Note tool, or select text and add a note to a highlight."
                       Foreground="{DynamicResource HintTextBrush}" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="{Binding HasComments, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
