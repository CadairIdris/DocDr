<Window x:Class="DocDr.App.Views.OcrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OcrProgressViewModel}"
        Title="Recognise text (OCR)" Width="420" SizeToContent="Height"
        Icon="/DocDr.App;component/Assets/DocDr.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
        <ProgressBar Height="16" Minimum="0" Maximum="100"
                     Value="{Binding Progress}"
                     IsIndeterminate="{Binding IsIndeterminate}" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="This edits the document and can't be undone. The original file is untouched until you save." />
        <Button Content="Cancel" MinWidth="90" Padding="8,4" Margin="0,14,0,0"
                HorizontalAlignment="Right" IsCancel="True"
                Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
    </StackPanel>
</Window>
