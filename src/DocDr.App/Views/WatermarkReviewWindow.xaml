<Window x:Class="DocDr.App.Views.WatermarkReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:WatermarkReviewViewModel}"
        Title="Remove watermark" Width="720" Height="620"
        Icon="/DocDr.App;component/Assets/DocDr.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MinWidth="560" MinHeight="440">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="80" Padding="8,4" Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Content="Remove" MinWidth="90" Padding="8,4" IsDefault="True"
                    Command="{Binding RemoveCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Content that repeats across most pages. Tick what to strip, then Remove. This edits page content and can't be undone — save to a new file to keep the original." />

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"
                   Foreground="{DynamicResource HintTextBrush}"
                   Text="{Binding SecurityNote}"
                   Visibility="{Binding HasSecurityNote, Converter={StaticResource BoolToVisibility}}" />

        <Grid DockPanel.Dock="Top" Height="300" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,6,0" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PageBackgroundBrush}">
                <Grid>
                    <Image Source="{Binding BeforePreview}" Stretch="Uniform" Margin="6" />
                    <TextBlock Text="Before" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="8,6" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"
                               Background="{DynamicResource OverlayCardBrush}" Padding="4,1" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="6,0,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PageBackgroundBrush}">
                <Grid>
                    <Image Source="{Binding AfterPreview}" Stretch="Uniform" Margin="6" />
                    <TextBlock Text="After (all removed)" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="8,6" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"
                               Background="{DynamicResource OverlayCardBrush}" Padding="4,1" />
                    <TextBlock Text="rendering…" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource HintTextBrush}"
                               Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <ListBox ItemsSource="{Binding Rows}" BorderThickness="1"
                 BorderBrush="{DynamicResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WatermarkRowViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding Warning}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ActiveHighlightPen}"
                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Kind}" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource HintTextBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
