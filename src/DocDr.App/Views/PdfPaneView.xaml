<UserControl x:Class="DocDr.App.Views.PdfPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PdfPaneViewModel}"
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <!-- Compact glyph buttons: the Fluent default padding would clip a 26px-wide icon button. -->
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- View-mode selector: icon toggle buttons (a RadioButton wears the Fluent
             ToggleButton look, so it picks up the accent fill when checked). -->
        <Geometry x:Key="IconSinglePage">M4.5,2.5 H11.5 V13.5 H4.5 Z</Geometry>
        <Geometry x:Key="IconContinuous">M5,0.5 H11 V6 H5 Z M5,10 H11 V15.5 H5 Z</Geometry>
        <Geometry x:Key="IconGrid">M2.5,2.5 H7 V7 H2.5 Z M9,2.5 H13.5 V7 H9 Z M2.5,9 H7 V13.5 H2.5 Z M9,9 H13.5 V13.5 H9 Z</Geometry>

        <Style x:Key="ModeToggle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Stroke"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- One rendered page: its bitmap plus any search-highlight overlay. -->
        <DataTemplate x:Key="PageSlotTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <Grid Width="{Binding LayoutWidth}" Height="{Binding LayoutHeight}"
                  Margin="8" Background="{DynamicResource PaperBrush}" SnapsToDevicePixels="True">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
                </Grid.Effect>
                <Image Source="{Binding Image}" Stretch="Fill" />
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                       Fill="{Binding IsActive, Converter={StaticResource HighlightFill}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource ActiveHighlightPen}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Single / continuous: the list item is one page. -->
        <DataTemplate x:Key="PageListItemTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSlotTemplate}" />
        </DataTemplate>

        <!-- Grid: the list item is a row of pages. -->
        <DataTemplate x:Key="PageRowTemplate" DataType="{x:Type vm:PageRowViewModel}">
            <ItemsControl ItemsSource="{Binding Slots}" HorizontalAlignment="Center"
                          ItemTemplate="{StaticResource PageSlotTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pane toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="4" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="◄" Style="{StaticResource GlyphButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                    <TextBox x:Name="PageBox" Width="40" Margin="2,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding CurrentPage, UpdateSourceTrigger=LostFocus}"
                             KeyDown="PageBox_KeyDown" />
                    <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="2,0" />
                    <Button Content="►" Style="{StaticResource GlyphButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="−" Style="{StaticResource GlyphButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out" />
                    <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center"
                               Width="46" TextAlignment="Center" />
                    <Button Content="+" Style="{StaticResource GlyphButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in" />
                    <Button Content="100%" Margin="4,0,0,0" Padding="4,1" Command="{Binding ActualSizeCommand}" />
                    <Button Content="Fit W" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitWidthCommand}" />
                    <Button Content="Fit P" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitPageCommand}" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <!-- No GroupName: these RadioButtons group by their StackPanel parent, so the
                     left and right pane keep independent selections. A shared GroupName would
                     put all six buttons (both panes) in one group, and the hidden right pane's
                     binding would silently steal the check from the visible left pane on launch. -->
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.SinglePage}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=SinglePage, Mode=OneWay}"
                                 AutomationProperties.Name="Page" ToolTip="Single page">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconSinglePage}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.Continuous}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Continuous, Mode=OneWay}"
                                 AutomationProperties.Name="Continuous" ToolTip="Continuous scroll">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconContinuous}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.Grid}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Grid, Mode=OneWay}"
                                 AutomationProperties.Name="Grid" ToolTip="Grid of pages (columns auto-fit the width)">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconGrid}" />
                    </RadioButton>
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Grid Width="150">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search this view">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Search this view…" Margin="7,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{DynamicResource HintTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ToggleButton Content="Aa" MinWidth="30" Padding="4,2" Margin="2,0"
                                  IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                    <Button Content="Prev" Padding="4,1" Margin="2,0,0,0" Command="{Binding PreviousMatchCommand}" ToolTip="Previous match" />
                    <Button Content="Next" Padding="4,1" Margin="2,0,0,0" Command="{Binding NextMatchCommand}" ToolTip="Next match" />
                    <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Margin="4,0" MinWidth="52" />
                    <ProgressBar IsIndeterminate="True" Width="40" Height="6" Margin="2,0"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Page surface (ItemsSource + ItemTemplate are set from code-behind per view mode) -->
        <ListBox x:Name="PageList" Grid.Row="1"
                 Background="{DynamicResource PageBackgroundBrush}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.ScrollChanged="PageList_ScrollChanged"
                 PreviewMouseWheel="PageList_PreviewMouseWheel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
