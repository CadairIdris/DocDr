<UserControl x:Class="DocDr.App.Views.PdfPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             xmlns:views="clr-namespace:DocDr.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PdfPaneViewModel}"
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <!-- Compact glyph buttons: the Fluent default padding would clip a 26px-wide icon button. -->
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- View-mode selector: icon toggle buttons (a RadioButton wears the Fluent
             ToggleButton look, so it picks up the accent fill when checked). -->
        <Geometry x:Key="IconSinglePage">M4.5,2.5 H11.5 V13.5 H4.5 Z</Geometry>
        <Geometry x:Key="IconContinuous">M5,0.5 H11 V6 H5 Z M5,10 H11 V15.5 H5 Z</Geometry>
        <Geometry x:Key="IconGrid">M2.5,2.5 H7 V7 H2.5 Z M9,2.5 H13.5 V7 H9 Z M2.5,9 H7 V13.5 H2.5 Z M9,9 H13.5 V13.5 H9 Z</Geometry>

        <Style x:Key="ModeToggle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="ModeIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Stroke"
                    Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- One rendered page: its bitmap plus any search-highlight overlay. -->
        <DataTemplate x:Key="PageSlotTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <Grid Width="{Binding LayoutWidth}" Height="{Binding LayoutHeight}"
                  Margin="8" Background="{DynamicResource PaperBrush}" SnapsToDevicePixels="True">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
                </Grid.Effect>
                <Image Source="{Binding Image}" Stretch="Fill" />
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                       Fill="{Binding IsActive, Converter={StaticResource HighlightFill}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource ActiveHighlightPen}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- In-document link regions (TOC entries, cross-references, URLs). Transparent
                     buttons so a click follows the link instead of starting a text selection. -->
                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinkVisual}">
                            <Button Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                    Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand"
                                    BorderThickness="0" Focusable="False"
                                    ToolTip="{Binding Tooltip}"
                                    AutomationProperties.Name="{Binding Tooltip}"
                                    Command="{Binding DataContext.FollowLinkCommand, RelativeSource={RelativeSource AncestorType={x:Type views:PdfPaneView}}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Hit" Background="Transparent">
                                            <Border x:Name="Glow" Background="{DynamicResource AccentBrush}"
                                                    Opacity="0" CornerRadius="1" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glow" Property="Opacity" Value="0.18" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Annotation overlay: highlight bands + a note marker per annotation. -->
                <ItemsControl ItemsSource="{Binding Annotations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AnnotationVisual}">
                            <Canvas>
                                <!-- Freehand highlighter strokes. -->
                                <ItemsControl ItemsSource="{Binding Strokes}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polyline Points="{Binding}"
                                                      Stroke="{Binding DataContext.StrokeBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Polyline.Style>
                                                    <Style TargetType="Polyline">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True"
                                                                         Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#8A6FBF" BlurRadius="7" ShadowDepth="0" Opacity="0.95" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Polyline.Style>
                                            </Polyline>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Rects}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                       Fill="{Binding DataContext.FillBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="StrokeThickness" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True"
                                                                         Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="StrokeThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Revision cloud outline. -->
                                <Path Data="{Binding CloudGeometry}" Stroke="{Binding ShapeBrush}" StrokeThickness="1.6"
                                      IsHitTestVisible="False"
                                      Visibility="{Binding IsCloud, Converter={StaticResource BoolToVisibility}}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#8A6FBF" BlurRadius="7" ShadowDepth="0" Opacity="0.95" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                                <!-- Callout leader line + arrow. -->
                                <Canvas IsHitTestVisible="False"
                                        Visibility="{Binding IsCallout, Converter={StaticResource BoolToVisibility}}">
                                    <Polyline Points="{Binding Leader}" Stroke="{Binding ShapeBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" />
                                    <Polyline Points="{Binding LeaderArrow}" Stroke="{Binding ShapeBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>

                                <!-- Text box / callout box. -->
                                <Border Canvas.Left="{Binding Box.X}" Canvas.Top="{Binding Box.Y}"
                                        Width="{Binding Box.Width}" Height="{Binding Box.Height}"
                                        BorderBrush="{Binding ShapeBrush}" BorderThickness="1.5"
                                        Background="Transparent" Cursor="SizeAll" ClipToBounds="True" Padding="3,2"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#8A6FBF" BlurRadius="7" ShadowDepth="0" Opacity="0.95" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BoxText}" TextWrapping="Wrap"
                                               Width="{Binding BoxTextWidth}" HorizontalAlignment="Left"
                                               Foreground="{Binding ShapeBrush}" FontSize="{Binding BoxFontSize}" />
                                </Border>

                                <Button Canvas.Left="{Binding Marker.X}" Canvas.Top="{Binding Marker.Y}"
                                        Width="{Binding Marker.Width}" Height="{Binding Marker.Height}"
                                        Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand"
                                        Background="{DynamicResource OverlayCardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        ToolTip="Edit annotation"
                                        Visibility="{Binding ShowMarker, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.EditAnnotationCommand, RelativeSource={RelativeSource AncestorType={x:Type views:PdfPaneView}}}"
                                        CommandParameter="{Binding Id}">
                                    <Path Data="M2,2 H12 V9 H6 L3,12 V9 H2 Z" Stretch="Uniform" Margin="2"
                                          Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" />
                                </Button>

                                <!-- Delete affordance for a selected highlight. -->
                                <Button Canvas.Left="{Binding Marker.X}" Canvas.Top="{Binding Marker.Y}"
                                        Width="{Binding Marker.Width}" Height="{Binding Marker.Height}"
                                        Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand"
                                        Background="{DynamicResource OverlayCardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        ToolTip="Delete highlight"
                                        Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeleteAnnotationCommand, RelativeSource={RelativeSource AncestorType={x:Type views:PdfPaneView}}}"
                                        CommandParameter="{Binding Id}">
                                    <Path Data="M3,4 H13 M6.5,4 V2.5 H9.5 V4 M4.5,4 L5,13 H11 L11.5,4"
                                          Stretch="Uniform" Margin="2.5"
                                          Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Live text selection during a drag. -->
                <ItemsControl ItemsSource="{Binding SelectionRects}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.35" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Highlighter stroke being drawn right now. -->
                <Canvas IsHitTestVisible="False">
                    <Polyline Points="{Binding InkPreview}"
                              StrokeThickness="{Binding InkPreviewThickness}"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Polyline.Stroke>
                            <SolidColorBrush Color="{Binding InkPreviewBrush}" Opacity="0.45" />
                        </Polyline.Stroke>
                    </Polyline>
                </Canvas>

                <!-- Shape being dragged out right now (box, plus a callout's leader + arrow). -->
                <Canvas IsHitTestVisible="False"
                        Visibility="{Binding ShapePreview, Converter={StaticResource NotNullToVisibility}}">
                    <Polyline Points="{Binding ShapePreviewLeader}" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.4" StrokeDashArray="4 3" StrokeLineJoin="Round" />
                    <Polyline Points="{Binding ShapePreviewArrow}" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.4" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Rectangle Canvas.Left="{Binding ShapePreview.X}" Canvas.Top="{Binding ShapePreview.Y}"
                               Width="{Binding ShapePreview.Width}" Height="{Binding ShapePreview.Height}"
                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeDashArray="4 3" />
                </Canvas>
            </Grid>
        </DataTemplate>

        <!-- Single / continuous: the list item is one page. -->
        <DataTemplate x:Key="PageListItemTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSlotTemplate}" />
        </DataTemplate>

        <!-- Panels the page list swaps between per view mode. -->
        <ItemsPanelTemplate x:Key="VerticalPagesPanel">
            <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SpreadPanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ItemsPanelTemplate>

        <!-- Grid: the list item is a row of pages. -->
        <DataTemplate x:Key="PageRowTemplate" DataType="{x:Type vm:PageRowViewModel}">
            <ItemsControl ItemsSource="{Binding Slots}" HorizontalAlignment="Center"
                          ItemTemplate="{StaticResource PageSlotTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pane toolbar (hidden in read mode) -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding DataContext.IsReadMode, RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}">
            <WrapPanel Margin="4" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="◄" Style="{StaticResource GlyphButton}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                    <TextBox x:Name="PageBox" Width="40" Margin="2,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding CurrentPage, UpdateSourceTrigger=LostFocus}"
                             KeyDown="PageBox_KeyDown" />
                    <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="2,0" />
                    <Button Content="►" Style="{StaticResource GlyphButton}" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="−" Style="{StaticResource GlyphButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out" />
                    <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center"
                               Width="46" TextAlignment="Center" />
                    <Button Content="+" Style="{StaticResource GlyphButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in" />
                    <Button Content="100%" Margin="4,0,0,0" Padding="4,1" Command="{Binding ActualSizeCommand}" />
                    <Button Content="Fit W" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitWidthCommand}" />
                    <Button Content="Fit P" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitPageCommand}" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <!-- No GroupName: these RadioButtons group by their StackPanel parent, so the
                     left and right pane keep independent selections. A shared GroupName would
                     put all six buttons (both panes) in one group, and the hidden right pane's
                     binding would silently steal the check from the visible left pane on launch. -->
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.SinglePage}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=SinglePage, Mode=OneWay}"
                                 AutomationProperties.Name="Page" ToolTip="Single page">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconSinglePage}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.Continuous}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Continuous, Mode=OneWay}"
                                 AutomationProperties.Name="Continuous" ToolTip="Continuous scroll">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconContinuous}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ModeToggle}"
                                 Tag="{x:Static vm:ViewMode.Grid}" Checked="ModeRadio_Checked"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Grid, Mode=OneWay}"
                                 AutomationProperties.Name="Grid" ToolTip="Grid of pages (columns auto-fit the width)">
                        <Path Style="{StaticResource ModeIcon}" Data="{StaticResource IconGrid}" />
                    </RadioButton>
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Grid Width="150">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search this view">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Search this view…" Margin="7,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{DynamicResource HintTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ToggleButton Content="Aa" MinWidth="30" Padding="4,2" Margin="2,0"
                                  IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                    <Button Content="Prev" Padding="4,1" Margin="2,0,0,0" Command="{Binding PreviousMatchCommand}" ToolTip="Previous match" />
                    <Button Content="Next" Padding="4,1" Margin="2,0,0,0" Command="{Binding NextMatchCommand}" ToolTip="Next match" />
                    <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Margin="4,0" MinWidth="52" />
                    <ProgressBar IsIndeterminate="True" Width="40" Height="6" Margin="2,0"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Page surface (ItemsSource + ItemTemplate are set from code-behind per view mode) -->
        <ListBox x:Name="PageList" Grid.Row="1"
                 Background="{DynamicResource PageBackgroundBrush}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.ScrollChanged="PageList_ScrollChanged"
                 PreviewMouseWheel="PageList_PreviewMouseWheel"
                 PreviewMouseLeftButtonDown="PageList_MouseLeftButtonDown"
                 PreviewMouseMove="PageList_MouseMove"
                 PreviewMouseLeftButtonUp="PageList_MouseLeftButtonUp"
                 PreviewKeyDown="PageList_PreviewKeyDown">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HighlighterToolActive}" Value="True">
                            <Setter Property="Cursor" Value="Pen" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CommentToolActive}" Value="True">
                            <Setter Property="Cursor" Value="Cross" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShapeTool}" Value="TextBox">
                            <Setter Property="Cursor" Value="Cross" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShapeTool}" Value="Callout">
                            <Setter Property="Cursor" Value="Cross" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShapeTool}" Value="Cloud">
                            <Setter Property="Cursor" Value="Cross" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Floating action popup shown after a text selection. -->
        <Popup x:Name="SelectionPopup" Grid.Row="1" AllowsTransparency="True"
               Placement="MousePoint" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource OverlayCardBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6"
                    Effect="{x:Null}">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding HighlightColorKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="24" Height="22" Margin="2,0" Padding="0" Cursor="Hand"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Background="{Binding Converter={StaticResource HighlightSwatch}}"
                                        ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                        Click="ColorSwatch_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="1" Margin="6,2" Background="{DynamicResource BorderBrush}" />
                    <Button Content="Comment…" Padding="8,3" Cursor="Hand"
                            Command="{Binding CommentOnSelectionCommand}"
                            Click="PopupAction_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
