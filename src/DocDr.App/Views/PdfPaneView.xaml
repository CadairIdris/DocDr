<UserControl x:Class="DocDr.App.Views.PdfPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PdfPaneViewModel}"
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
        <!-- One rendered page: its bitmap plus any search-highlight overlay. -->
        <DataTemplate x:Key="PageSlotTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <Grid Width="{Binding LayoutWidth}" Height="{Binding LayoutHeight}"
                  Margin="8" Background="White" SnapsToDevicePixels="True">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
                </Grid.Effect>
                <Image Source="{Binding Image}" Stretch="Fill" />
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                       Fill="{Binding IsActive, Converter={StaticResource HighlightFill}}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="StrokeThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource ActiveHighlightPen}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Single / continuous: the list item is one page. -->
        <DataTemplate x:Key="PageListItemTemplate" DataType="{x:Type vm:PageSlotViewModel}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSlotTemplate}" />
        </DataTemplate>

        <!-- Grid: the list item is a row of pages. -->
        <DataTemplate x:Key="PageRowTemplate" DataType="{x:Type vm:PageRowViewModel}">
            <ItemsControl ItemsSource="{Binding Slots}" HorizontalAlignment="Center"
                          ItemTemplate="{StaticResource PageSlotTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pane toolbar -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Margin="4" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="◄" Width="26" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" />
                    <TextBox x:Name="PageBox" Width="40" Margin="2,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Text="{Binding CurrentPage, UpdateSourceTrigger=LostFocus}"
                             KeyDown="PageBox_KeyDown" />
                    <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="2,0" />
                    <Button Content="►" Width="26" Command="{Binding NextPageCommand}" ToolTip="Next page" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{StaticResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <Button Content="−" Width="26" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out" />
                    <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center"
                               Width="46" TextAlignment="Center" />
                    <Button Content="+" Width="26" Command="{Binding ZoomInCommand}" ToolTip="Zoom in" />
                    <Button Content="100%" Margin="4,0,0,0" Padding="4,1" Command="{Binding ActualSizeCommand}" />
                    <Button Content="Fit W" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitWidthCommand}" />
                    <Button Content="Fit P" Margin="2,0,0,0" Padding="4,1" Command="{Binding FitPageCommand}" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{StaticResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <RadioButton GroupName="Mode" Content="Page" Padding="6,1" VerticalContentAlignment="Center"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=SinglePage}"
                                 ToolTip="Single page" />
                    <RadioButton GroupName="Mode" Content="Continuous" Padding="6,1" VerticalContentAlignment="Center"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Continuous}"
                                 ToolTip="Continuous scroll" />
                    <RadioButton GroupName="Mode" Content="Grid" Padding="6,1" VerticalContentAlignment="Center"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Grid}"
                                 ToolTip="Grid of pages (columns auto-fit the width)" />
                </StackPanel>

                <Border Width="1" Margin="6,2" Background="{StaticResource BorderBrush}" />

                <StackPanel Orientation="Horizontal" Margin="2,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="150" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search this view">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <ToggleButton Content="Aa" Width="26" Margin="2,0" IsChecked="{Binding MatchCase}"
                                  ToolTip="Match case" />
                    <Button Content="Prev" Padding="4,1" Margin="2,0,0,0" Command="{Binding PreviousMatchCommand}" ToolTip="Previous match" />
                    <Button Content="Next" Padding="4,1" Margin="2,0,0,0" Command="{Binding NextMatchCommand}" ToolTip="Next match" />
                    <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Margin="4,0" MinWidth="52" />
                    <ProgressBar IsIndeterminate="True" Width="40" Height="6" Margin="2,0"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Page surface (ItemsSource + ItemTemplate are set from code-behind per view mode) -->
        <ListBox x:Name="PageList" Grid.Row="1"
                 Background="{StaticResource PageBackgroundBrush}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.ScrollChanged="PageList_ScrollChanged"
                 PreviewMouseWheel="PageList_PreviewMouseWheel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
