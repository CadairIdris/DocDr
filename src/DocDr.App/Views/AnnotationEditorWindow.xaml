<Window x:Class="DocDr.App.Views.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AnnotationEditorViewModel}"
        Title="{Binding Title}" Width="360" SizeToContent="Height"
        Icon="/DocDr.App;component/Assets/DocDr.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Delete" MinWidth="70" Padding="8,4" Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Cancel" MinWidth="70" Padding="8,4" Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save" MinWidth="70" Padding="8,4" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel>
            <DockPanel Margin="0,0,0,10"
                       Visibility="{Binding ShowColors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsShape, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,5,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox Width="52" ItemsSource="{Binding FontSizes}"
                              SelectedItem="{Binding FontSize, Mode=TwoWay}" ToolTip="Text size in points" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColorKey, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="26" Height="20" CornerRadius="3" Margin="2"
                                    Background="{Binding Converter={StaticResource HighlightSwatch}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    ToolTip="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <TextBox Text="{Binding Contents, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" x:Name="ContentsBox" />

            <StackPanel Margin="0,8,0,0">
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                    <Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Created, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource HintTextBrush}" FontSize="11"
                           Visibility="{Binding ShowModified, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="edited " /><Run Text="{Binding Modified, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!-- Reply thread -->
            <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Visibility="{Binding HasThread, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Thread}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Attribution}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewReply, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         d:Text="" Tag="Write a reply…" />
                <Button Grid.Column="1" Content="Reply" MinWidth="60" Padding="8,4" Margin="8,0,0,0"
                        VerticalAlignment="Bottom" Command="{Binding AddReplyCommand}" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
