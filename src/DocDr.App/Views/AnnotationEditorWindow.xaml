<Window x:Class="DocDr.App.Views.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AnnotationEditorViewModel}"
        Title="{Binding Title}" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Delete" MinWidth="70" Padding="8,4" Margin="0,0,8,0"
                    Command="{Binding DeleteCommand}"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Cancel" MinWidth="70" Padding="8,4" Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save" MinWidth="70" Padding="8,4" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>

        <StackPanel>
            <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColorKey, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" Margin="0,0,0,10"
                     Visibility="{Binding IsHighlight, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="26" Height="20" CornerRadius="3" Margin="2"
                                Background="{Binding Converter={StaticResource HighlightSwatch}}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                ToolTip="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBox Text="{Binding Contents, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" x:Name="ContentsBox" />

            <StackPanel Margin="0,8,0,0">
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11">
                    <Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Created, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource HintTextBrush}" FontSize="11"
                           Visibility="{Binding ShowModified, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="edited " /><Run Text="{Binding Modified, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
