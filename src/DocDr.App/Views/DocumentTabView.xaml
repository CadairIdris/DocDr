<UserControl x:Class="DocDr.App.Views.DocumentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DocDr.App.Views"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentTabViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Auto = size to the panel (or to 0 when it's collapsed). The GridSplitter writes an
                 explicit pixel width here on drag, which then persists across show/hide. -->
            <ColumnDefinition Width="Auto" MinWidth="0" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding IsSplitView, Converter={StaticResource SplitViewWidth}}" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <views:NavigationPanelView Grid.Column="0" MinWidth="150"
                                   Visibility="{Binding IsNavigationPanelVisible, Converter={StaticResource BoolToVisibility}}" />

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsNavigationPanelVisible, Converter={StaticResource BoolToVisibility}}" />

        <views:PdfPaneView Grid.Column="2" DataContext="{Binding LeftPane}" />

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsSplitView, Converter={StaticResource BoolToVisibility}}" />

        <views:PdfPaneView Grid.Column="4" DataContext="{Binding RightPane}"
                           Visibility="{Binding DataContext.IsSplitView,
                                        RelativeSource={RelativeSource AncestorType={x:Type views:DocumentTabView}},
                                        Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
