<UserControl x:Class="DocDr.App.Views.BookmarksPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocDr.App.ViewModels"
             xmlns:views="clr-namespace:DocDr.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BookmarksViewModel}"
             d:DesignHeight="500" d:DesignWidth="200">
    <Grid Background="{DynamicResource ChromeBrush}">
        <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
                  BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  SelectedItemChanged="Tree_SelectedItemChanged"
                  PreviewKeyDown="Tree_PreviewKeyDown"
                  Visibility="{Binding HasBookmarks, Converter={StaticResource BoolToVisibility}}">
            <TreeView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Rename" InputGestureText="F2"
                              Command="{Binding BeginRenameCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=Tree}" />
                    <MenuItem Header="Delete" InputGestureText="Del"
                              Command="{Binding DeleteNodeCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=Tree}" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="2,3" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_RightButtonDown" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:BookmarkNodeViewModel}" ItemsSource="{Binding Children}">
                    <Grid MinWidth="140">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Margin="-2,0"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                 IsVisibleChanged="RenameBox_IsVisibleChanged" LostFocus="RenameBox_LostFocus"
                                 PreviewKeyDown="RenameBox_PreviewKeyDown" />
                        <TextBlock Grid.Column="1" Text="{Binding PageLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="6,0,2,0" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16"
                    Visibility="{Binding HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="This document has no bookmarks." Foreground="{DynamicResource HintTextBrush}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Generate from headings" Padding="8,4" Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource {x:Type Button}}"
                    Command="{Binding DataContext.GenerateBookmarksCommand,
                              RelativeSource={RelativeSource AncestorType=views:NavigationPanelView}}" />
        </StackPanel>
    </Grid>
</UserControl>
