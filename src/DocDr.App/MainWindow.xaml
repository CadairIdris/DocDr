<Window x:Class="DocDr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DocDr.App.Views"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        xmlns:services="clr-namespace:DocDr.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}" Height="820" Width="1280"
        Icon="Assets/DocDr.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop"
        Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SelectedTab.SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding SelectedTab.PrintCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SelectedTab.SaveAsCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding SelectedTab.UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding SelectedTab.RedoCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="F" Command="{Binding FindInFilesCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleReadModeCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitReadModeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Toolbar tools read as "on" with a filled accent pill when active. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ChromeBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="TabContextMenu" x:Shared="False">
            <MenuItem Header="Move to other side" Command="{Binding MoveToOtherSideCommand}"
                      ToolTip="Dock this document on the other side of the window (or drag its tab across)" />
            <Separator />
            <MenuItem Header="Close" Command="{Binding CloseCommand}" />
        </ContextMenu>

        <!-- One docked tab strip + its documents. Both sides of the window use it; each side's
             DataContext is a TabGroupViewModel. -->
        <Style x:Key="DocumentTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="ItemsSource" Value="{Binding Tabs}" />
            <Setter Property="SelectedItem" Value="{Binding SelectedTab, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,2,2,0" Panel.ZIndex="1"
                                      Visibility="{Binding DataContext.IsReadMode, RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource InverseBoolToVisibility}}" />
                            <Border Background="{DynamicResource PageBackgroundBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ContextMenu" Value="{StaticResource TabContextMenu}" />
                        <!-- Drag a tab across to dock it side by side (MainWindow.xaml.cs). -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
                        <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TabItem_PreviewMouseLeftButtonUp" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                        <!-- Fluent's tab strip has almost no contrast in dark mode; give each
                             header its own chrome so the tabs read as tabs. -->
                        <Border x:Name="TabChrome" CornerRadius="4,4,0,0" Padding="8,3"
                                Margin="0,2,1,0" BorderThickness="1,1,1,0"
                                MinWidth="150" MaxWidth="260"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource TabItemBrush}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0" Padding="3,0"
                                        FontSize="10" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding CloseCommand}" ToolTip="Close tab" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource TabItemActiveBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,2,1,0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                        <views:DocumentTabView />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A docked side. While two are docked, the active one (what the toolbar acts on) gets an
             accent rule along its top edge. -->
        <Style x:Key="TabGroupHost" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,2,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toolbar icons (16×16 stroke paths, drawn with the NavTabIcon style from App.xaml so
             they follow the button's Foreground — accent-on-checked, greyed when disabled). -->
        <Geometry x:Key="TbFile">M1.5,4 H6 L7.5,5.5 H14.5 V13 H1.5 Z</Geometry>
        <Geometry x:Key="TbSave">M2.5,2.5 H11 L13.5,5 V13.5 H2.5 Z M5,2.5 V5.5 H10 V2.5 M5,13.5 V9.5 H11 V13.5</Geometry>
        <Geometry x:Key="TbUndo">M5,3.5 L2.5,6 L5,8.5 M2.5,6 H10 A3,3 0 0 1 10,12 H6</Geometry>
        <Geometry x:Key="TbRedo">M11,3.5 L13.5,6 L11,8.5 M13.5,6 H6 A3,3 0 0 0 6,12 H10</Geometry>
        <Geometry x:Key="TbDraw">M10.5,2.5 L13.5,5.5 L6,13 H3 V10 Z M9,4 L12,7</Geometry>
        <Geometry x:Key="TbTextBox">M2.5,3.5 H13.5 V12.5 H2.5 Z M5.5,6 H10.5 M8,6 V10.5</Geometry>
        <Geometry x:Key="TbCallout">M6,2.5 H14 V9 H6 Z M7.5,9 L2.5,13.5</Geometry>
        <Geometry x:Key="TbCloud">M4.5,12 A2.5,2.5 0 0 1 3.5,7 A2.8,2.8 0 0 1 8,4.5 A3,3 0 0 1 12.8,6.8 A2.6,2.6 0 0 1 12,12 Z</Geometry>
        <Geometry x:Key="TbRectangle">M2.5,4 H13.5 V12 H2.5 Z</Geometry>
        <Geometry x:Key="TbEllipse">M2.5,8 A5.5,4 0 1 1 13.5,8 A5.5,4 0 1 1 2.5,8 Z</Geometry>
        <Geometry x:Key="TbLine">M3,13 L13,3</Geometry>
        <Geometry x:Key="TbArrow">M3,13 L13,3 M8,3 H13 V8</Geometry>
        <Geometry x:Key="TbEye">M1.5,8 Q8,1.5 14.5,8 Q8,14.5 1.5,8 Z M8,6 A2,2 0 1 1 8,10 A2,2 0 1 1 8,6 Z</Geometry>
        <Geometry x:Key="TbEyeOff">M1.5,8 Q8,1.5 14.5,8 Q8,14.5 1.5,8 Z M8,6 A2,2 0 1 1 8,10 A2,2 0 1 1 8,6 Z M2.5,13.5 L13.5,2.5</Geometry>
        <Geometry x:Key="TbPages">M5,1.5 H13 V11.5 M3,4 H11 V14.5 H3 Z</Geometry>
        <Geometry x:Key="TbTools">M2.5,4 H13.5 M2.5,8 H13.5 M2.5,12 H13.5 M5,2.5 V5.5 M10.5,6.5 V9.5 M7,10.5 V13.5</Geometry>
        <Geometry x:Key="TbSplit">M2,2.5 H14 V13.5 H2 Z M8,2.5 V13.5</Geometry>
        <Geometry x:Key="TbSideBySide">M2.5,5.5 H13 M10.5,3 L13,5.5 L10.5,8 M13.5,10.5 H3 M5.5,8 L3,10.5 L5.5,13</Geometry>
        <Geometry x:Key="TbLink">M6.5,9.5 L9.5,6.5 M7,5 L8.5,3.5 A2.6,2.6 0 0 1 12.5,7.5 L11,9 M9,11 L7.5,12.5 A2.6,2.6 0 0 1 3.5,8.5 L5,7</Geometry>
        <Geometry x:Key="TbRead">M2.5,6 V2.5 H6 M10,2.5 H13.5 V6 M13.5,10 V13.5 H10 M6,13.5 H2.5 V10</Geometry>
        <Geometry x:Key="TbTheme">M8,2.5 A5.5,5.5 0 1 1 8,13.5 A5.5,5.5 0 1 1 8,2.5 Z M8,2.5 V13.5 M8,5 H11.5 M8,8 H13.5 M8,11 H11.5</Geometry>
        <Geometry x:Key="TbChevron">M0.5,0.5 L3,3 L5.5,0.5</Geometry>

        <!-- The small ▾ after a toolbar dropdown's icon. -->
        <Style x:Key="TbChevronPath" TargetType="Path" BasedOn="{StaticResource NavTabIcon}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="3,1,0,0" />
            <Setter Property="Data" Value="{StaticResource TbChevron}" />
        </Style>

        <!-- Icon in a toolbar dropdown's MenuItem (the menu item's Foreground, not a ButtonBase's). -->
        <Style x:Key="MenuIcon" TargetType="Path" BasedOn="{StaticResource NavTabIcon}">
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top"
                     Visibility="{Binding IsReadMode, Converter={StaticResource InverseBoolToVisibility}}">
            <!-- One row, grouped by how often each thing is used: once-per-document actions
                 (file, page edits, document tools) live in dropdowns; the tools you reach for
                 constantly (annotation) stay on the bar as icons. Dropdowns are a Button that
                 opens its own ContextMenu (DropDown_Click), so the menu inherits the window's
                 DataContext and the Fluent ContextMenu style. -->
            <ToolBar>
                <!-- ── File ──────────────────────────────────────────────── -->
                <Button Padding="6,4" Click="DropDown_Click"
                        AutomationProperties.Name="File menu"
                        ToolTip="File — open, new, merge, save as, print, properties, find in files">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbFile}" />
                        <Path Style="{StaticResource TbChevronPath}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Open PDF…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                            <MenuItem Header="_New document…" Command="{Binding NewDocumentCommand}"
                                      ToolTip="Create a blank page to build a collage on" />
                            <MenuItem Header="_Merge PDFs…" Command="{Binding MergeCommand}"
                                      ToolTip="Combine several PDFs into one new document" />
                            <Separator />
                            <MenuItem Header="_Save" Command="{Binding SelectedTab.SaveCommand}"
                                      IsEnabled="{Binding HasTabs}" InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save _As…" Command="{Binding SelectedTab.SaveAsCommand}"
                                      IsEnabled="{Binding HasTabs}" InputGestureText="Ctrl+Shift+S" />
                            <Separator />
                            <MenuItem Header="_Print…" Command="{Binding SelectedTab.PrintCommand}"
                                      IsEnabled="{Binding HasTabs}" InputGestureText="Ctrl+P"
                                      ToolTip="Print the document with edits and annotations" />
                            <MenuItem Header="P_roperties…" Command="{Binding SelectedTab.ShowPropertiesCommand}"
                                      IsEnabled="{Binding HasTabs}"
                                      ToolTip="View / edit document metadata" />
                            <Separator />
                            <MenuItem Header="_Find in files…" Command="{Binding FindInFilesCommand}"
                                      InputGestureText="Ctrl+Shift+F"
                                      ToolTip="Search every PDF in a folder for a term" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Padding="6,4" Margin="2,0,0,0" Command="{Binding SelectedTab.SaveCommand}"
                        IsEnabled="{Binding HasTabs}" AutomationProperties.Name="Save" ToolTip="Save (Ctrl+S)">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbSave}" />
                </Button>
                <Button Padding="6,4" Margin="2,0,0,0" Command="{Binding SelectedTab.UndoCommand}"
                        AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbUndo}" />
                </Button>
                <Button Padding="6,4" Margin="2,0,0,0" Command="{Binding SelectedTab.RedoCommand}"
                        AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbRedo}" />
                </Button>
                <Separator />

                <!-- ── Annotate ─────────────────────────────────────────── -->
                <ToggleButton Padding="6,4" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.CommentToolActive, Mode=TwoWay}"
                              AutomationProperties.Name="Note tool"
                              ToolTip="Note — click a page to drop a note. Or select text and use the highlight popup.">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource IconAnnotations}" />
                </ToggleButton>
                <ToggleButton Padding="6,4" Margin="2,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.HighlighterToolActive, Mode=TwoWay}"
                              AutomationProperties.Name="Highlighter tool"
                              ToolTip="Draw — freehand highlighter strokes on the page">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbDraw}" />
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding SelectedTab.InkColorKeys}" VerticalAlignment="Center" Margin="2,0,0,0"
                              IsEnabled="{Binding HasTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="18" Height="18" Margin="1,0" Padding="0" Cursor="Hand"
                                    ToolTip="{Binding}" BorderThickness="0"
                                    Background="{Binding Converter={StaticResource HighlightSwatch}}"
                                    Click="InkColor_Click" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Sw" CornerRadius="3" Background="{TemplateBinding Background}"
                                                BorderThickness="2" BorderBrush="Transparent" />
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource Equality}">
                                                        <Binding Path="." />
                                                        <Binding Path="DataContext.SelectedTab.InkColorKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ToggleButton Padding="6,4" Margin="6,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                          Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=TextBox}"
                              AutomationProperties.Name="Text box tool"
                              ToolTip="Text box — drag on the page to drop a text box">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbTextBox}" />
                </ToggleButton>
                <ToggleButton Padding="6,4" Margin="2,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                          Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Callout}"
                              AutomationProperties.Name="Callout tool"
                              ToolTip="Callout — drag from what you're pointing at to where the note goes">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbCallout}" />
                </ToggleButton>
                <ToggleButton Padding="6,4" Margin="2,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                          Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Cloud}"
                              AutomationProperties.Name="Cloud tool"
                              ToolTip="Cloud — drag a rectangle to cloud a revised area">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbCloud}" />
                </ToggleButton>
                <!-- Shapes split button: the toggle re-arms the last basic shape used; the ▾
                     picks a different one. -->
                <ToggleButton Padding="6,4" Margin="2,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.IsBasicShapeActive, Mode=TwoWay}"
                              AutomationProperties.Name="Shape tool"
                              ToolTip="Shape — drag a rectangle, ellipse, line or arrow (▾ to choose)">
                    <Path>
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource NavTabIcon}">
                                <Setter Property="Data" Value="{StaticResource TbRectangle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.LastBasicShape}" Value="Ellipse">
                                        <Setter Property="Data" Value="{StaticResource TbEllipse}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.LastBasicShape}" Value="Line">
                                        <Setter Property="Data" Value="{StaticResource TbLine}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.LastBasicShape}" Value="Arrow">
                                        <Setter Property="Data" Value="{StaticResource TbArrow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>
                <Button Padding="2,4" Click="DropDown_Click" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Choose shape" ToolTip="Choose a shape">
                    <Path Style="{StaticResource TbChevronPath}" Margin="0,1,0,0" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Rectangle" IsCheckable="True"
                                      IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Rectangle}">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIcon}" Data="{StaticResource TbRectangle}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Ellipse" IsCheckable="True"
                                      IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Ellipse}">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIcon}" Data="{StaticResource TbEllipse}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Line" IsCheckable="True"
                                      IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Line}">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIcon}" Data="{StaticResource TbLine}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Arrow" IsCheckable="True"
                                      IsChecked="{Binding SelectedTab.ShapeTool, Mode=TwoWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Arrow}">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIcon}" Data="{StaticResource TbArrow}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Padding="6,4" Margin="4,0,0,0"
                        Command="{Binding SelectedTab.ToggleAnnotationsCommand}"
                        IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Toggle markup"
                        ToolTip="{Binding SelectedTab.MarkupToolTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Tag" Value="{StaticResource TbEye}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.AnnotationsVisible}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ChromeBrush}" />
                                    <Setter Property="Tag" Value="{StaticResource TbEyeOff}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Style="{StaticResource NavTabIcon}"
                          Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Separator />

                <!-- ── Pages / Tools (once-per-document) ─────────────────── -->
                <Button Padding="6,4" Click="DropDown_Click" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Pages menu"
                        ToolTip="Pages — rotate, delete, insert">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbPages}" />
                        <Path Style="{StaticResource TbChevronPath}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rotate _left" Command="{Binding SelectedTab.RotateLeftCommand}"
                                      ToolTip="Rotate selected / current page left" />
                            <MenuItem Header="Rotate _right" Command="{Binding SelectedTab.RotateRightCommand}"
                                      ToolTip="Rotate selected / current page right" />
                            <Separator />
                            <MenuItem Header="_Delete page(s)" Command="{Binding SelectedTab.DeletePagesCommand}"
                                      ToolTip="Delete selected / current page(s)" />
                            <Separator />
                            <MenuItem Header="Insert _PDF…" Command="{Binding SelectedTab.InsertPdfCommand}"
                                      ToolTip="Insert every page of another PDF" />
                            <MenuItem Header="Insert _blank page" Command="{Binding SelectedTab.InsertBlankPageCommand}"
                                      ToolTip="Insert a blank page after the current one, matching its size" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Padding="6,4" Margin="2,0,0,0" Click="DropDown_Click" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Tools menu"
                        ToolTip="Tools — extract table, OCR, remove watermark, trim margins, export chunks">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbTools}" />
                        <Path Style="{StaticResource TbChevronPath}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Extract _table" IsCheckable="True"
                                      IsChecked="{Binding SelectedTab.TableSelectActive, Mode=TwoWay}"
                                      ToolTip="Drag a rectangle over a table to reconstruct its rows and columns" />
                            <Separator />
                            <MenuItem Header="_OCR…" Command="{Binding SelectedTab.OcrDocumentCommand}"
                                      ToolTip="Recognise text on scanned pages and add a searchable layer" />
                            <MenuItem Header="Remove _watermark…" Command="{Binding SelectedTab.RemoveWatermarksCommand}"
                                      ToolTip="Find and remove content repeated on every page" />
                            <MenuItem Header="Trim _margins" Command="{Binding SelectedTab.TrimMarginsCommand}"
                                      ToolTip="Crop every page to its visible content plus a small margin" />
                            <Separator />
                            <MenuItem Header="Export _chunks…" Command="{Binding SelectedTab.ExportRagChunksCommand}"
                                      ToolTip="Split the text into overlapping, section-tagged JSONL chunks for RAG" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Separator />

                <!-- ── View ─────────────────────────────────────────────── -->
                <ToggleButton Padding="6,4" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.IsSplitView, Mode=TwoWay}"
                              AutomationProperties.Name="Split view"
                              ToolTip="Split view — a second, independent pane for this document">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbSplit}" />
                </ToggleButton>
                <Button Padding="6,4" Margin="2,0,0,0"
                        Command="{Binding SelectedTab.MoveToOtherSideCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Move to other side"
                        ToolTip="Side by side — dock this document on the other side of the window (or drag its tab to the right edge)">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbSideBySide}" />
                </Button>
                <ToggleButton Padding="6,4" Margin="2,0,0,0" Style="{StaticResource ToolToggle}"
                              IsEnabled="{Binding IsSideBySide}"
                              IsChecked="{Binding IsScrollLinked, Mode=TwoWay}"
                              AutomationProperties.Name="Link scrolling"
                              ToolTip="Link scrolling — scroll and zoom the two side-by-side documents together. Line them up first — the page offset between them is kept.">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbLink}" />
                </ToggleButton>
                <Button Padding="6,4" Margin="2,0,0,0"
                        Command="{Binding ToggleReadModeCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Read mode"
                        ToolTip="Read mode — full-screen two-page reading view (F11 · Esc to exit)">
                    <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbRead}" />
                </Button>
                <Separator />
                <Button Padding="6,4" Click="DropDown_Click"
                        AutomationProperties.Name="Theme" ToolTip="Theme — follow the OS, or force light / dark">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavTabIcon}" Data="{StaticResource TbTheme}" />
                        <Path Style="{StaticResource TbChevronPath}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Follow _system" Click="Theme_Click" Tag="{x:Static services:AppTheme.System}"
                                      IsChecked="{Binding SelectedTheme, Mode=OneWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=System}" />
                            <MenuItem Header="_Light" Click="Theme_Click" Tag="{x:Static services:AppTheme.Light}"
                                      IsChecked="{Binding SelectedTheme, Mode=OneWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Light}" />
                            <MenuItem Header="_Dark" Click="Theme_Click" Tag="{x:Static services:AppTheme.Dark}"
                                      IsChecked="{Binding SelectedTheme, Mode=OneWay,
                                                  Converter={StaticResource EnumEqualsOrDefault}, ConverterParameter=Dark}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsReadMode, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{Binding AppVersionLabel}" Margin="0,0,6,0" Padding="6,1"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        FontSize="11" Foreground="{DynamicResource HintTextBrush}"
                        Command="{Binding AboutCommand}"
                        AutomationProperties.Name="About DocDr" ToolTip="About DocDr" />
                <TextBlock Margin="8,3" Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- Two docked tab strips. The right one only has tabs while documents are side by side;
                 column widths are driven from code-behind (ApplyGroupLayout). -->
            <Grid x:Name="TabArea" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftGroupColumn" Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightGroupColumn" Width="0" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <Border x:Name="LeftGroupHost" Grid.Column="0" DataContext="{Binding LeftGroup}"
                        Style="{StaticResource TabGroupHost}"
                        PreviewMouseDown="GroupHost_PreviewMouseDown"
                        PreviewGotKeyboardFocus="GroupHost_PreviewGotKeyboardFocus">
                    <TabControl Style="{StaticResource DocumentTabControl}" />
                </Border>

                <GridSplitter x:Name="GroupSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed" />

                <Border x:Name="RightGroupHost" Grid.Column="2" DataContext="{Binding RightGroup}"
                        Style="{StaticResource TabGroupHost}"
                        PreviewMouseDown="GroupHost_PreviewMouseDown"
                        PreviewGotKeyboardFocus="GroupHost_PreviewGotKeyboardFocus">
                    <TabControl Style="{StaticResource DocumentTabControl}" />
                </Border>

                <!-- Shown only while a tab is being dragged: the zone it can be dropped on. -->
                <Canvas x:Name="TabDropOverlay" Grid.ColumnSpan="3" Visibility="Collapsed"
                        Background="Transparent" AllowDrop="True"
                        DragOver="TabDropOverlay_DragOver" DragLeave="TabDropOverlay_DragLeave"
                        Drop="TabDropOverlay_Drop">
                    <Grid x:Name="TabDropZone">
                        <Rectangle x:Name="TabDropZoneFill" Fill="{DynamicResource AccentBrush}" Opacity="0.15"
                                   RadiusX="6" RadiusY="6" />
                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="6" />
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,10"
                                Background="{DynamicResource OverlayCardBrush}" CornerRadius="6"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="TabDropZoneText" FontSize="15" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Canvas>
            </Grid>

            <!-- Home screen (shown when no document is open) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasTabs, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="560" Margin="24,40">
                    <Image Source="/DocDr.App;component/Assets/DocDr.png" Width="56" Height="56"
                           HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DocDr" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,10,0,2" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Open a PDF to begin, or drop PDF files anywhere in this window."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding AppVersionLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="11" Foreground="{DynamicResource HintTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="Open PDF…" Command="{Binding OpenCommand}" Padding="16,5" />
                        <Button Content="New document…" Command="{Binding NewDocumentCommand}" Padding="16,5"
                                Margin="8,0,0,0" AutomationProperties.Name="New document" />
                        <Button Content="Merge PDFs…" Command="{Binding MergeCommand}" Padding="16,5"
                                Margin="8,0,0,0" AutomationProperties.Name="Merge PDFs" />
                        <Button Content="Find in files…" Command="{Binding FindInFilesCommand}" Padding="16,5"
                                Margin="8,0,0,0" AutomationProperties.Name="Find in files" />
                    </StackPanel>

                    <Grid Margin="0,30,0,6"
                          Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Recent" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="Clear" HorizontalAlignment="Right" Padding="6,1"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource HintTextBrush}"
                                Command="{Binding ClearRecentFilesCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentFiles}"
                                  Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                <Button Margin="0,1" Padding="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Path}">
                                    <Grid Margin="10,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="  (not found)" FontSize="11"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Folder}" FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="5,2"
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource HintTextBrush}"
                                                ToolTip="Remove from list"
                                                Command="{Binding DataContext.RemoveRecentFileCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

        <!-- Read-mode hint / exit -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,14,0"
                Background="{DynamicResource OverlayCardBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,5"
                Visibility="{Binding IsReadMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Read mode — ← → or scroll to turn · Esc to exit"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Content="✕" Margin="10,0,0,0" Padding="6,1" FontSize="11"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding ExitReadModeCommand}" ToolTip="Exit read mode" />
            </StackPanel>
        </Border>

        <!-- Drag-and-drop overlay -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource OverlayScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource OverlayCardBrush}" CornerRadius="8" Padding="40,28"
                    BorderBrush="{DynamicResource ActiveHighlightPen}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Drop to open" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="PDF files open as tabs" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
