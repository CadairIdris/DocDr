<Window x:Class="DocDr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DocDr.App.Views"
        xmlns:vm="clr-namespace:DocDr.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}" Height="820" Width="1280"
        Icon="Assets/DocDr.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop"
        Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SelectedTab.SaveCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SelectedTab.SaveAsCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding SelectedTab.UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding SelectedTab.RedoCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
    </Window.InputBindings>
    <Grid>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding OpenCommand}" Content="Open PDF…" Padding="10,3" />
                <Separator />
                <Button Content="Pages" Padding="8,3"
                        IsEnabled="{Binding HasTabs}"
                        Command="{Binding SelectedTab.ToggleNavigationCommand}"
                        CommandParameter="{x:Static vm:NavigationTab.Pages}"
                        ToolTip="Page thumbnail strip" />
                <Button Content="Bookmarks" Padding="8,3" Margin="4,0,0,0"
                        IsEnabled="{Binding HasTabs}"
                        Command="{Binding SelectedTab.ToggleNavigationCommand}"
                        CommandParameter="{x:Static vm:NavigationTab.Bookmarks}"
                        ToolTip="Document outline / bookmarks" />
                <Separator />
                <Button Content="Watermark…" Padding="8,3"
                        Command="{Binding SelectedTab.RemoveWatermarksCommand}"
                        IsEnabled="{Binding HasTabs}" AutomationProperties.Name="Remove watermark"
                        ToolTip="Find and remove content repeated on every page" />
                <Separator />
                <ToggleButton Content="Split view" Padding="8,3"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.IsSplitView, Mode=TwoWay}"
                              ToolTip="Show a second, independent pane for this document" />
                <ToggleButton Content="💬 Note" Padding="8,3" Margin="4,0,0,0"
                              IsEnabled="{Binding HasTabs}"
                              IsChecked="{Binding SelectedTab.CommentToolActive, Mode=TwoWay}"
                              AutomationProperties.Name="Comment tool"
                              ToolTip="Click a page to drop a comment. Or select text and use the highlight popup." />
                <Separator />
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <!-- Explicit type-default style: a ToolBar otherwise forces the classic
                     (non-Fluent) ComboBox style, whose drop-down stays white in dark mode. -->
                <ComboBox VerticalAlignment="Center" MinWidth="76"
                          Style="{StaticResource {x:Type ComboBox}}"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          ToolTip="Follow the OS theme, or force light / dark" />
            </ToolBar>

            <ToolBar>
                <Button Content="Properties…" Padding="8,3" Command="{Binding SelectedTab.ShowPropertiesCommand}"
                        IsEnabled="{Binding HasTabs}" AutomationProperties.Name="Properties"
                        ToolTip="View / edit document metadata" />
                <Separator />
                <Button Content="Save" Padding="8,3" Command="{Binding SelectedTab.SaveCommand}"
                        IsEnabled="{Binding HasTabs}" ToolTip="Save (Ctrl+S)" />
                <Button Content="Save As…" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding SelectedTab.SaveAsCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Save As"
                        ToolTip="Save a copy (Ctrl+Shift+S)" />
                <Separator />
                <Button Content="↶" FontSize="14" Padding="7,1" Command="{Binding SelectedTab.UndoCommand}"
                        AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" />
                <Button Content="↷" FontSize="14" Padding="7,1" Margin="2,0,0,0"
                        Command="{Binding SelectedTab.RedoCommand}"
                        AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" />
                <Separator />
                <Button Content="Rotate ⟲" Padding="8,3" Command="{Binding SelectedTab.RotateLeftCommand}"
                        IsEnabled="{Binding HasTabs}" AutomationProperties.Name="Rotate left"
                        ToolTip="Rotate selected / current page left" />
                <Button Content="Rotate ⟳" Padding="8,3" Margin="2,0,0,0"
                        Command="{Binding SelectedTab.RotateRightCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Rotate right"
                        ToolTip="Rotate selected / current page right" />
                <Button Content="Delete page(s)" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding SelectedTab.DeletePagesCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Delete pages"
                        ToolTip="Delete selected / current page(s)" />
                <Button Content="Insert PDF…" Padding="8,3" Margin="4,0,0,0"
                        Command="{Binding SelectedTab.InsertPdfCommand}" IsEnabled="{Binding HasTabs}"
                        AutomationProperties.Name="Insert PDF"
                        ToolTip="Insert every page of another PDF" />
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Margin="8,3" Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <TabControl ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                        <!-- Fluent's tab strip has almost no contrast in dark mode; give each
                             header its own chrome so the tabs read as tabs. -->
                        <Border x:Name="TabChrome" CornerRadius="4,4,0,0" Padding="8,3"
                                Margin="0,2,1,0" BorderThickness="1,1,1,0"
                                MinWidth="150" MaxWidth="260"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource TabItemBrush}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✕" Margin="8,0,0,0" Padding="3,0"
                                        FontSize="10" VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding CloseCommand}" ToolTip="Close tab" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource TabItemActiveBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,2,1,0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                        <views:DocumentTabView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Home screen (shown when no document is open) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasTabs, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="460" Margin="24,40">
                    <Image Source="/DocDr.App;component/Assets/DocDr.png" Width="56" Height="56"
                           HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DocDr" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,10,0,2" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Open a PDF to begin, or drop PDF files anywhere in this window."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Content="Open PDF…" Command="{Binding OpenCommand}" Padding="16,5"
                            HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <Grid Margin="0,30,0,6"
                          Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Recent" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="Clear" HorizontalAlignment="Right" Padding="6,1"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource HintTextBrush}"
                                Command="{Binding ClearRecentFilesCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentFiles}"
                                  Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
                                <Button Margin="0,1" Padding="0" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Path}">
                                    <Grid Margin="10,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="  (not found)" FontSize="11"
                                                           Foreground="{DynamicResource HintTextBrush}"
                                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Folder}" FontSize="11"
                                                       Foreground="{DynamicResource HintTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="5,2"
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource HintTextBrush}"
                                                ToolTip="Remove from list"
                                                Command="{Binding DataContext.RemoveRecentFileCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

        <!-- Drag-and-drop overlay -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource OverlayScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource OverlayCardBrush}" CornerRadius="8" Padding="40,28"
                    BorderBrush="{DynamicResource ActiveHighlightPen}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Drop to open" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="PDF files open as tabs" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
