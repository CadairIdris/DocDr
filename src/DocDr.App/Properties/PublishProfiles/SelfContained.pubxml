<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish: bundles the .NET runtime, so DocDr runs on a machine with
  no .NET installed. Larger output.

  VS / Rider: right-click DocDr.App > Publish > this profile.
  CLI:        pwsh publish.ps1 -Mode self-contained   (add -SingleFile for one .exe)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
