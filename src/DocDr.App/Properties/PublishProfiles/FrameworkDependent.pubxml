<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent publish: needs the .NET 9 Desktop Runtime installed on the
  target machine. Much smaller output.

  VS / Rider: right-click DocDr.App > Publish > this profile.
  CLI:        pwsh publish.ps1 -Mode framework-dependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- R2R off for framework-dependent: the target runtime patch can differ from the
         publish-time pack, and R2R + single file fail-fasts instead of JIT-falling-back. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
