<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DocDr.Ocr</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The Tesseract wrapper ships XML docs that trip a few analyzer warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TesseractOCR" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocDr.Pdf\DocDr.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled recognition model (tessdata_fast/eng). Copied next to the app as tessdata/. -->
    <Content Include="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tessdata\eng.traineddata</Link>
    </Content>
  </ItemGroup>

</Project>
