<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DocDr.Pdf</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindings only: PDFiumCore's bundled pdfium (4688) mis-maps some ToUnicode entries (maths
         glyphs come out as Syriac/Oriya letters). The native library comes from bblanchon's current
         pdfium-binaries instead; the flat C API PDFiumCore binds is ABI-stable across those builds. -->
    <PackageReference Include="PDFiumCore" Version="4688.0.0" ExcludeAssets="native" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="158.0.8125" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure helpers (PdfTextMatcher, PdfPageTextCache) are unit-tested directly. -->
    <InternalsVisibleTo Include="DocDr.Pdf.Tests" />
  </ItemGroup>

</Project>
